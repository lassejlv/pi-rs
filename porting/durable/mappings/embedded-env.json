 "substitutedDependencies": [
  {
   "package": "@silvia-odwyer/photon@0.3.3",
   "entry": "node_modules/@silvia-odwyer/photon/photon_rs.js",
   "servedBy": "pi-durable:internal/photon (crates/pi-durable-jsrt/js/internal/photon.js) over photon-rs 0.3.3 natively (src/dispatch/images.rs photon.*)",
   "scope": "embedded_stock runner and its node-mode children only (absolute-path alias in examples/embedded_stock.rs)",
   "surface": [
    "initSync",
    "default (async init)",
    "PhotonImage(rawPixels, width, height)",
    "PhotonImage.new_from_byteslice",
    "get_width",
    "get_height",
    "get_raw_pixels",
    "get_bytes",
    "get_bytes_jpeg",
    "free"
   ],
   "reason": "The package is photon-rs 0.3.3 compiled to WebAssembly; pi-jsrt runs WebAssembly on the wasmi interpreter, where the tests' fixture encoders (4000x1000 PNG: 3.6-6 s) exceed their original timeouts. Same Rust source, same version; durable code never imports it (its images are native already). photon_rs_bg.wasm stays in place for images-wasm-module.test.ts, which compiles it."
  }
 ],
