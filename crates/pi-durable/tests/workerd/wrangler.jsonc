{
	"name": "pi-durable-workerd-tests",
	"main": "./worker.mjs",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"durable_objects": {
		"bindings": [
			{ "name": "SESSIONS", "class_name": "TestSession" },
			{ "name": "WAKE", "class_name": "WakeSession" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["TestSession"] },
		{ "tag": "v2", "new_sqlite_classes": ["WakeSession"] }
	]
}
